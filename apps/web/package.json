  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "srvx --prod -s ../client dist/server/server.js",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint:fsd": "steiger ./src",
