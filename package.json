{
  "name": "taskflow-example",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:es && pnpm --filter web lint:fsd && pnpm lint:deps && pnpm lint:dup",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "lint:dup": "jscpd",
    "test": "turbo run test",
    "tokens": "pnpm --filter @repo/tokens build",
    "storybook": "pnpm --filter @repo/ui storybook",
    "check": "pnpm tokens:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "tokens:check": "pnpm --filter @repo/tokens check",
    "lint:es": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "jscpd": "^5.4.3",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "tailwindcss": "^4.3.5"
  }
}
